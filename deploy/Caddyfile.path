# Alternative to ../Caddyfile: serves QuantLab at https://<your domain>/quantlab/ when this
# server also hosts the rest of the site. Copy it over ../Caddyfile to use it.
{$QUANTLAB_DOMAIN} {
	encode gzip

	redir /quantlab /quantlab/
	handle_path /quantlab/* {
		reverse_proxy quantlab:8000
	}

	# Everything else on the domain. Replace this block with your existing
	# website (for example `root * /srv/site` + `file_server`, or a
	# `reverse_proxy` to wherever the site runs).
	handle {
		respond "Not found" 404
	}
}
