# Serves QuantLab at https://<your domain>/quantlab/ with automatic HTTPS.
# Nothing on the site links to it, search engines are told not to index it,
# and the app itself asks for the password.
{$QUANTLAB_DOMAIN} {
	encode gzip

	redir /quantlab /quantlab/
	handle_path /quantlab/* {
		reverse_proxy quantlab:8000
	}

	# Everything else on the domain. Replace this block with your existing
	# website (for example `root * /srv/site` + `file_server`, or a
	# `reverse_proxy` to wherever the site runs).
	handle {
		respond "Not found" 404
	}
}
