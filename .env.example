# The subdomain QuantLab is served on, e.g. quantlab.example.com
QUANTLAB_DOMAIN=
# Password for the web app. Required when the app is reachable from the internet.
QUANTLAB_PASSWORD=
# Optional: Anthropic API key for the Assistant tab (https://console.anthropic.com). Usage is billed to this key.
ANTHROPIC_API_KEY=
# Optional: set to 1 to let the assistant search the web (must be enabled for your Anthropic account).
QUANTLAB_CHAT_WEB_SEARCH=
